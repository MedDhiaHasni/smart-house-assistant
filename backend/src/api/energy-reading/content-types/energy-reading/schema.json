{
  "kind": "collectionType",
  "collectionName": "energy_readings",
  "info": {
    "singularName": "energy-reading",
    "pluralName": "energy-readings",
    "displayName": "Energy Reading"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "externalId": { "type": "string", "required": true, "unique": true },
    "value": { "type": "decimal", "required": true },
    "unit": { "type": "string", "default": "kWh" },
    "measuredAt": { "type": "datetime", "required": true },
    "source": { "type": "string", "required": true },
    "device": { "type": "relation", "relation": "manyToOne", "target": "api::device.device" }
  }
}
