{
  "kind": "collectionType",
  "collectionName": "rooms",
  "info": {
    "singularName": "room",
    "pluralName": "rooms",
    "displayName": "Room"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true },
    "floor": { "type": "integer", "default": 0 },
    "status": { "type": "enumeration", "enum": ["occupied", "vacant", "unknown"], "default": "unknown" },
    "devices": { "type": "relation", "relation": "oneToMany", "target": "api::device.device", "mappedBy": "room" }
  }
}
